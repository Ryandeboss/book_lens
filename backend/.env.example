PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
# Optional additional comma-separated browser origins.
CORS_ORIGINS=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional cloud OCR. Leave project/processor blank for browser Tesseract fallback.
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_DOCUMENT_AI_LOCATION=us
GOOGLE_DOCUMENT_AI_PROCESSOR_ID=
# Render: /etc/secrets/google-service-account.json. Local: absolute path outside repo, or ADC.
GOOGLE_APPLICATION_CREDENTIALS=
# Optional MP3 export uses the same backend-only Google ADC identity.
# Enable Cloud Text-to-Speech API and billing in its Google project.
TTS_LANGUAGE_CODE=en-US
TTS_VOICE_NAME=en-US-Standard-C
TTS_TIMEOUT_MS=45000
TTS_REQUESTS_PER_MINUTE=60
OCR_MAX_CONCURRENT_REQUESTS=2
OCR_REQUESTS_PER_MINUTE=30
OCR_TIMEOUT_MS=45000

# Optional text-only AI cleanup; backend/Render only, never VITE_*.
OPENAI_API_KEY=
OPENAI_PROOFREAD_MODEL=gpt-5.4-nano
PROOFREAD_TIMEOUT_MS=45000
PROOFREAD_REQUESTS_PER_MINUTE=30
